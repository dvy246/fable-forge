---
import SiteLayout from '../layouts/SiteLayout.astro';
import ToolCards from '../components/ToolCards.astro';
import { dndClasses } from '../data/dnd-classes';
import { raceBySlug } from '../data/races';
import { utilityBySlug } from '../data/utilities';
import { articleSchema, faqPageSchema } from '../lib/seo';

const title = 'DnD Classes: The Complete 5e Character Guide';
const description = 'Discover all official DnD classes with hit dice, primary abilities, combat roles, playstyles, and subclass breakdowns in our complete tabletop 5e guide.';
const path = '/dnd-classes/';

const breadcrumbs = [
  { label: 'Home', path: '/' },
  { label: 'DnD Classes', path: '/dnd-classes/' },
];

const faqItems = [
  {
    question: 'What is the easiest DnD class for beginners?',
    answer: 'Fighter and Barbarian are widely recognized as the easiest DnD classes for newcomers. Both classes emphasize straightforward combat loops, generous hit point pools, and minimal resource tracking compared to spellcasting classes. Fighters rely on consistent weapon attacks and the simple recovery mechanic of Second Wind, while Barbarians use Rage for immediate offensive and defensive buffs without juggling spell slots or preparation lists.',
  },
  {
    question: 'What are the strongest DnD classes in 5e?',
    answer: 'Wizard, Cleric, and Paladin consistently rank among the most powerful DnD classes. Wizards offer unmatched arcane utility and encounter-ending battlefield control spells. Clerics combine heavy armor durability, full spellcasting progression, and game-altering healing and radiant burst damage. Paladins dominate single-target burst through Divine Smite while granting essential party-wide saving throw bonuses through their Aura of Protection.',
  },
  {
    question: 'How do hit dice work across DnD classes?',
    answer: 'Hit dice determine both a character starting maximum health and their hit point recovery during short rests. The d12 die belongs exclusively to the Barbarian for maximum durability. The d10 die serves frontline martial warriors including Fighters, Paladins, Rangers, and Blood Hunters. The d8 die provides moderate resilience for mid-range combatants such as Bards, Clerics, Druids, Monks, Rogues, and Artificers. The d6 die belongs to fragile arcane casters like Sorcerers and Wizards.',
  },
  {
    question: 'Can you multiclass between any DnD classes?',
    answer: 'Multiclassing requires meeting specific ability score prerequisites for both your current class and your new class, typically a minimum score of 13 in the primary ability. For instance, multiclassing into or out of Paladin requires a Strength of 13 and a Charisma of 13. While multiclassing unlocks potent feature combinations, it delays high-tier spell access, extra attacks, and ability score improvements.',
  },
  {
    question: 'What is the difference between prepared and known spellcasters?',
    answer: 'Known casters like Bards, Sorcerers, Warlocks, and Rangers choose a fixed pool of spells as they level up and cannot change them during daily rests. Prepared casters like Clerics, Druids, Paladins, Artificers, and Wizards can swap their active spell loadout at the end of each long rest from their entire spell list or spellbook, granting superior tactical adaptability before dungeon crawls.',
  },
];

const faqSchema = faqPageSchema(faqItems);
const schema = [
  articleSchema(title, description, path),
  ...(faqSchema ? [faqSchema] : []),
];

function getClassCategory(slug) {
  if (['barbarian', 'fighter', 'monk', 'rogue', 'blood-hunter'].includes(slug)) {
    return 'martial';
  }
  if (['paladin', 'ranger', 'artificer'].includes(slug)) {
    return 'half-caster';
  }
  return 'spellcaster';
}

const phaseTwoEnabled = import.meta.env.PUBLIC_BUILD_PHASE_2 !== 'false';
const relatedSlugs = phaseTwoEnabled
  ? [
      'character-name-generator',
      'party-name-generator',
      'npc-name-generator',
      'last-name-generator',
    ]
  : [
      'elf-name-generator',
      'dwarf-name-generator',
      'human-name-generator',
      'tiefling-name-generator',
    ];

const relatedItems = relatedSlugs.map((slug) => {
  const race = raceBySlug.get(slug);
  if (race) {
    return {
      slug: race.slug,
      title: `${race.label} names`,
      description: race.intro[0],
      eyebrow: 'Ancestry names',
    };
  }
  const utility = utilityBySlug.get(slug);
  if (utility) {
    return {
      slug: utility.slug,
      title: utility.label,
      description: utility.intro[0],
      eyebrow: 'Campaign utility',
    };
  }
  return null;
}).filter(Boolean);

const frameworkSections = [
  {
    id: 'framework-pillars',
    label: '1. Decision Pillars',
    tip: 'Balance resource horizons, positioning, and rule complexity before choosing.',
  },
  {
    id: 'framework-roles',
    label: '2. Combat Roles',
    tip: 'Tanks anchor chokepoints, Strikers burst single targets, Controllers shape terrain, Supports buff.',
  },
  {
    id: 'framework-hitdice',
    label: '3. Hit Die Tiers',
    tip: 'Compare baseline HP and recuperation capacity across all 14 official character classes.',
  },
  {
    id: 'framework-economy',
    label: '4. Resource Economy',
    tip: 'Short rest sustainability vs long rest encounter-warping spells.',
  },
  {
    id: 'framework-breakdowns',
    label: '5. Class Breakdown',
    tip: 'Tactical play loops and vulnerabilities for all official classes.',
  },
  {
    id: 'framework-multiclass',
    label: '6. Multiclass Synergies',
    tip: 'Stat prerequisites, action economy, and optimized power dips.',
  },
  {
    id: 'framework-beginners',
    label: '7. Beginner Picks',
    tip: 'Straightforward loops and forgiving health pools for new players.',
  },
  {
    id: 'framework-ancestry',
    label: '8. Ancestry Synergies',
    tip: 'Pair complementary racial traits and evocative names with your class.',
  },
  {
    id: 'framework-faq',
    label: '9. Common Questions',
    tip: 'Key answers to common tabletop selection and mechanic questions.',
  },
];

const initialFrameworkLabel = frameworkSections[0].label;
const initialFrameworkTip = frameworkSections[0].tip;
---
<SiteLayout
  title={title}
  description={description}
  path={path}
  pageType="article"
  imageType="utility"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <section class="hero hero-classes">
    <div class="hero-classes-stage">
      <div class="hero-classes-narrative">
        <div class="hero-eyebrow-wrap">
          <span class="hero-eyebrow">
            <span class="hero-trust-indicator" aria-hidden="true"></span>
            Tabletop 5e Character Dossiers
          </span>
        </div>
        <h1 class="hero-classes-h1">DnD Classes: The Complete 5e Character Guide</h1>
        <p class="hero-copy">
          Discover all 14 official DnD classes with complete mechanical breakdowns, hit dice ratings, primary abilities, combat roles, playstyle radars, and subclass synergies in our authoritative tabletop 5e guide.
        </p>

        <div class="hero-specs-row" aria-label="Guide highlights">
          <div class="spec-chip">
            <span class="spec-num">14</span>
            <span class="spec-text">Official Classes</span>
          </div>
          <div class="spec-chip">
            <span class="spec-num">56+</span>
            <span class="spec-text">Subclasses</span>
          </div>
          <div class="spec-chip">
            <span class="spec-num">4</span>
            <span class="spec-text">Hit Die Tiers</span>
          </div>
          <div class="spec-chip">
            <span class="spec-num">100%</span>
            <span class="spec-text">Free Reference</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#classes-roster" class="hero-cta">
            <span>Explore All 14 Classes</span>
            <span class="hero-cta-arrow" aria-hidden="true">&darr;</span>
          </a>
          <a href="#class-guide" class="hero-secondary-cta">
            <span>Tactical Multiclass Guide</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="hero-spotlight-card" id="hero-spotlight-card" style="--spotlight-theme: #3b82f6;">
        <div class="spotlight-header">
          <div class="spotlight-badge-row">
            <span class="spotlight-kicker">Codex Spotlight</span>
            <span class="spotlight-role" id="spotlight-role">Frontline Tactician</span>
          </div>
          <span class="spotlight-hitdie" id="spotlight-hitdie">Hit Die: d10</span>
        </div>

        <div class="spotlight-visual-stage">
          <div class="spotlight-portrait-frame">
            <img
              id="spotlight-img"
              src="/characters/fighter.jpg"
              alt="Fighter character portrait"
              class="spotlight-img"
              width="240"
              height="240"
              loading="eager"
            />
            <div class="spotlight-portrait-rim" aria-hidden="true"></div>
          </div>
          <div class="spotlight-info">
            <h3 class="spotlight-name" id="spotlight-name">Fighter</h3>
            <span class="spotlight-subtitle" id="spotlight-subtitle">Battle Master Champion</span>
            <p class="spotlight-desc" id="spotlight-desc">
              Master of martial discipline, heavy armor, and devastating Action Surge bursts across tactical encounters.
            </p>
            <div class="spotlight-tags">
              <span class="spotlight-tag" id="spotlight-primary">Primary: Strength / Dex</span>
              <span class="spotlight-tag" id="spotlight-saves">Saves: Str &amp; Con</span>
            </div>
          </div>
        </div>

        <div class="spotlight-switcher" role="tablist" aria-label="Quick preview core archetypes">
          <span class="switcher-label">Preview Pillars:</span>
          <div class="switcher-chips">
            <button
              type="button"
              class="spotlight-chip is-active"
              data-spotlight-name="Fighter"
              data-spotlight-subtitle="Battle Master Champion"
              data-spotlight-role="Frontline Tactician"
              data-spotlight-hitdie="Hit Die: d10"
              data-spotlight-primary="Primary: Strength / Dex"
              data-spotlight-saves="Saves: Str &amp; Con"
              data-spotlight-desc="Master of martial discipline, heavy armor, and devastating Action Surge bursts across tactical encounters."
              data-spotlight-img="/characters/fighter.jpg"
              data-spotlight-color="#3b82f6"
              role="tab"
              aria-selected="true"
            >
              <span class="chip-pip" style="background-color: #3b82f6;"></span>
              <span>Fighter</span>
            </button>
            <button
              type="button"
              class="spotlight-chip"
              data-spotlight-name="Wizard"
              data-spotlight-subtitle="Master of the Arcane"
              data-spotlight-role="Arcane Controller"
              data-spotlight-hitdie="Hit Die: d6"
              data-spotlight-primary="Primary: Intelligence"
              data-spotlight-saves="Saves: Int &amp; Wis"
              data-spotlight-desc="Scholarly arcanist bending reality with ancient spellbooks, ritual preparation, and battlefield control."
              data-spotlight-img="/characters/wizard.jpg"
              data-spotlight-color="#6366f1"
              role="tab"
              aria-selected="false"
            >
              <span class="chip-pip" style="background-color: #6366f1;"></span>
              <span>Wizard</span>
            </button>
            <button
              type="button"
              class="spotlight-chip"
              data-spotlight-name="Rogue"
              data-spotlight-subtitle="Shadow Assassin"
              data-spotlight-role="Stealth Specialist"
              data-spotlight-hitdie="Hit Die: d8"
              data-spotlight-primary="Primary: Dexterity"
              data-spotlight-saves="Saves: Dex &amp; Int"
              data-spotlight-desc="Infiltration expert delivering lethal Sneak Attack strikes with cunning action and slippery evasion."
              data-spotlight-img="/characters/rogue.jpg"
              data-spotlight-color="#8b5cf6"
              role="tab"
              aria-selected="false"
            >
              <span class="chip-pip" style="background-color: #8b5cf6;"></span>
              <span>Rogue</span>
            </button>
            <button
              type="button"
              class="spotlight-chip"
              data-spotlight-name="Cleric"
              data-spotlight-subtitle="Forge &amp; Life Conduit"
              data-spotlight-role="Divine Bastion"
              data-spotlight-hitdie="Hit Die: d8"
              data-spotlight-primary="Primary: Wisdom"
              data-spotlight-saves="Saves: Wis &amp; Cha"
              data-spotlight-desc="Holy armor-clad champion channeling divine miracles, radiant burst wrath, and emergency party healing."
              data-spotlight-img="/characters/cleric.jpg"
              data-spotlight-color="#f59e0b"
              role="tab"
              aria-selected="false"
            >
              <span class="chip-pip" style="background-color: #f59e0b;"></span>
              <span>Cleric</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <nav class="hero-quick-jump-ribbon" aria-label="Quick jump to class">
      <div class="jump-ribbon-label">
        <span class="jump-ribbon-icon" aria-hidden="true">✦</span>
        <span>Quick Jump to Class:</span>
      </div>
      <div class="jump-ribbon-pills">
        {dndClasses.map((item) => (
          <a href={`#class-${item.slug}`} class="jump-ribbon-pill" style={`--pill-accent: ${item.themeColor};`}>
            <span class="pill-pip" style={`background-color: ${item.themeColor};`}></span>
            <span>{item.name}</span>
          </a>
        ))}
      </div>
    </nav>
  </section>

  <section class="page-section" id="classes-roster" aria-labelledby="roster-heading">
    <div class="section-topline">
      <div>
        <span class="eyebrow">Interactive Directory</span>
        <h2 id="roster-heading" class="section-heading">All 14 Character Classes</h2>
      </div>
      <div class="filter-controls" role="tablist" aria-label="Filter classes by archetype">
        <button type="button" class="filter-tab is-active" data-filter="all" role="tab" aria-selected="true">
          All (14)
        </button>
        <button type="button" class="filter-tab" data-filter="martial" role="tab" aria-selected="false">
          Martial (5)
        </button>
        <button type="button" class="filter-tab" data-filter="spellcaster" role="tab" aria-selected="false">
          Spellcasters (6)
        </button>
        <button type="button" class="filter-tab" data-filter="half-caster" role="tab" aria-selected="false">
          Half-Casters (3)
        </button>
      </div>
    </div>

    <div class="classes-sticky-stage">
      <aside class="classes-sticky-aside" aria-label="Active class overview">
        <div class="classes-sticky-card" id="classes-sticky-card">
          <div class="sticky-card-topline">
            <span class="sticky-kicker">Tabletop Codex</span>
            <span class="sticky-counter" id="sticky-class-counter">01 / 14</span>
          </div>

          <div class="sticky-crest-wrapper" id="sticky-crest-wrapper" style={`--active-color: ${dndClasses[0].themeColor};`}>
            <div class="sticky-portrait-thumb" id="sticky-portrait-thumb">
              <img
                id="sticky-portrait-img"
                src={dndClasses[0].imageSrc}
                alt={`${dndClasses[0].name} miniature`}
                class="sticky-thumb-img"
                width="56"
                height="56"
              />
              <div class="sticky-crest-icon" id="sticky-crest-icon" set:html={dndClasses[0].crestSvg} />
            </div>
            <div class="sticky-title-wrap">
              <span class="sticky-class-role" id="sticky-class-role">{dndClasses[0].roleCategory}</span>
              <h3 class="sticky-class-name" id="sticky-class-name">{dndClasses[0].name}</h3>
            </div>
          </div>

          <div class="sticky-stats-grid">
            <div class="sticky-stat-item">
              <span class="sticky-stat-label">Hit Die</span>
              <span class="sticky-stat-val" id="sticky-hit-die">
                <svg class="dice-icon-mini" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m12 2 8 4.5v11L12 22l-8-4.5v-11L12 2z" />
                  <path d="M12 2v20" />
                  <path d="m12 12 8-5.5" />
                  <path d="M12 12 4 6.5" />
                </svg>
                <strong id="sticky-hitdie-val">{dndClasses[0].hitDie}</strong>
              </span>
            </div>
            <div class="sticky-stat-item">
              <span class="sticky-stat-label">Primary</span>
              <span class="sticky-stat-val" id="sticky-primary-val">{dndClasses[0].primaryAbility.split(' ')[0]}</span>
            </div>
            <div class="sticky-stat-item">
              <span class="sticky-stat-label">Saves</span>
              <span class="sticky-stat-val" id="sticky-saves-val">{dndClasses[0].saves.split(' & ')[0]}</span>
            </div>
          </div>

          <p class="sticky-class-synopsis" id="sticky-synopsis-text">"{dndClasses[0].synopsis}"</p>

          <div class="sticky-nav-track">
            <span class="track-label">Directory Progress:</span>
            <div class="sticky-track-pills">
              {dndClasses.map((item, idx) => (
                <button
                  type="button"
                  class={`track-pill${idx === 0 ? ' is-active' : ''}`}
                  data-target-slug={item.slug}
                  data-class-index={idx + 1}
                  style={`--pill-accent: ${item.themeColor};`}
                  aria-label={`Scroll to ${item.name}`}
                >
                  <span class="track-pill-dot" style={`background-color: ${item.themeColor};`}></span>
                  <span class="track-pill-name">{item.name}</span>
                </button>
              ))}
            </div>
          </div>

          <a
            id="sticky-forge-cta"
            href={dndClasses[0].nameGeneratorUrl}
            class="sticky-forge-btn"
            style={`--btn-accent: ${dndClasses[0].themeColor};`}
          >
            <span id="sticky-cta-label">Forge {dndClasses[0].name} Names</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>

      <div class="classes-cards-scroll">
        {dndClasses.map((item, index) => {
          const category = getClassCategory(item.slug);
          return (
            <article
              id={`class-${item.slug}`}
              class={`class-dossier-card scroll-dossier-card${index === 0 ? ' is-active-card' : ''}`}
              data-category={category}
              data-class-slug={item.slug}
              data-class-name={item.name}
              data-class-role={item.roleCategory}
              data-class-hitdie={item.hitDie}
              data-class-primary={item.primaryAbility.split(' ')[0]}
              data-class-saves={item.saves.split(' & ')[0]}
              data-class-synopsis={item.synopsis}
              data-class-color={item.themeColor}
              data-class-image={item.imageSrc}
              data-class-url={item.nameGeneratorUrl}
              data-index={index + 1}
              style={`--class-theme: ${item.themeColor}; --class-accent: ${item.accentColor};`}
            >
              <div class="card-accent-line" style={`background-color: ${item.themeColor};`}></div>

              <header class="card-header">
                <div class="card-identity">
                  <div class="crest-wrapper" set:html={item.crestSvg} />
                  <div class="title-wrap">
                    <div class="badge-row">
                      <span class="ruleset-tag">{item.ruleset}</span>
                      <span class="role-badge">{item.roleCategory}</span>
                    </div>
                    <h3 class="class-name">{item.name}</h3>
                  </div>
                </div>
              </header>

              <div class="card-visual-showcase">
                <div class="portrait-container">
                  <img
                    src={item.imageSrc}
                    alt={`${item.name} character portrait`}
                    class="character-realistic-portrait"
                    width="240"
                    height="240"
                    loading={index < 2 ? 'eager' : 'lazy'}
                  />
                </div>
                <p class="card-synopsis">{item.synopsis}</p>
              </div>

              <div class="card-stats-grid">
                <div class="stat-pill">
                  <span class="stat-label">Hit Die</span>
                  <span class="dice-pill">
                    <svg class="dice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m12 2 8 4.5v11L12 22l-8-4.5v-11L12 2z" />
                      <path d="M12 2v20" />
                      <path d="m12 12 8-5.5" />
                      <path d="M12 12 4 6.5" />
                      <path d="m12 12 8 5.5" />
                      <path d="M12 12 4 17.5" />
                    </svg>
                    <strong>{item.hitDie}</strong>
                  </span>
                </div>
                <div class="stat-pill">
                  <span class="stat-label">Primary Ability</span>
                  <span class="stat-value">{item.primaryAbility}</span>
                </div>
                <div class="stat-pill">
                  <span class="stat-label">Saving Throws</span>
                  <span class="stat-value">{item.saves}</span>
                </div>
                <div class="stat-pill full-width">
                  <span class="stat-label">Armor & Weapon Proficiencies</span>
                  <span class="stat-subvalue">{item.armorProficiencies}; {item.weaponProficiencies}</span>
                </div>
              </div>

              <div class="card-block card-playstyle-section">
                <h4 class="card-block-heading">Playstyle Radar</h4>
                <div class="score-meters-grid">
                  <div class="score-meter">
                    <div class="meter-info">
                      <span class="meter-label">Offense</span>
                      <span class="meter-score">{item.playstyleScores.offense}/5</span>
                    </div>
                    <div class="meter-track">
                      <div class="meter-fill" style={`width: ${item.playstyleScores.offense * 20}%; background-color: ${item.themeColor};`}></div>
                    </div>
                  </div>
                  <div class="score-meter">
                    <div class="meter-info">
                      <span class="meter-label">Defense</span>
                      <span class="meter-score">{item.playstyleScores.defense}/5</span>
                    </div>
                    <div class="meter-track">
                      <div class="meter-fill" style={`width: ${item.playstyleScores.defense * 20}%; background-color: ${item.themeColor};`}></div>
                    </div>
                  </div>
                  <div class="score-meter">
                    <div class="meter-info">
                      <span class="meter-label">Support</span>
                      <span class="meter-score">{item.playstyleScores.support}/5</span>
                    </div>
                    <div class="meter-track">
                      <div class="meter-fill" style={`width: ${item.playstyleScores.support * 20}%; background-color: ${item.themeColor};`}></div>
                    </div>
                  </div>
                  <div class="score-meter">
                    <div class="meter-info">
                      <span class="meter-label">Utility</span>
                      <span class="meter-score">{item.playstyleScores.utility}/5</span>
                    </div>
                    <div class="meter-track">
                      <div class="meter-fill" style={`width: ${item.playstyleScores.utility * 20}%; background-color: ${item.themeColor};`}></div>
                    </div>
                  </div>
                  <div class="score-meter">
                    <div class="meter-info">
                      <span class="meter-label">Complexity</span>
                      <span class="meter-score">{item.playstyleScores.complexity}/5</span>
                    </div>
                    <div class="meter-track">
                      <div class="meter-fill" style={`width: ${item.playstyleScores.complexity * 20}%; background-color: ${item.themeColor};`}></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-block card-features-section">
                <h4 class="card-block-heading">Signature Features</h4>
                <div class="feature-chips">
                  {item.signatureFeatures.map((feature) => (
                    <span class="feature-chip">{feature}</span>
                  ))}
                </div>
              </div>

              <div class="card-block card-subclasses-section">
                <h4 class="card-block-heading">Notable Subclasses</h4>
                <div class="subclass-chips">
                  {item.subclasses.map((subclass) => (
                    <div class="subclass-chip">
                      <strong class="subclass-name">{subclass.name}</strong>
                      <span class="subclass-desc">{subclass.summary}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="card-block card-ancestry-section">
                <h4 class="card-block-heading">Synergistic Ancestries</h4>
                <div class="ancestry-links">
                  {item.bestAncestries.map((ancestry) => (
                    <a href={`/${ancestry.slug}/`} class="ancestry-link">
                      <span class="ancestry-bullet" aria-hidden="true">&loz;</span>
                      <span>{ancestry.label} Names</span>
                    </a>
                  ))}
                </div>
              </div>

              <div class="card-persona">
                <p><strong>Player Persona:</strong> {item.playerPersona}</p>
              </div>

              <div class="card-footer">
                <a href={item.nameGeneratorUrl} class="card-cta-btn" style={`--btn-accent: ${item.themeColor};`}>
                  <span>Generate {item.name} Names</span>
                  <span class="cta-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <article class="page-section seo-copy" data-seo-copy id="class-guide">
    <div class="classes-scroll-story">
      <aside class="classes-framework-aside" aria-label="Player Decision Framework Navigation">
        <div class="classes-framework-sticky-inner">
          <div class="framework-header-block">
            <span class="framework-kicker">Strategic Selection Guide</span>
            <h2 id="framework-heading" class="framework-main-title">
              How to Choose Your 5e Class: A Player Decision Framework
            </h2>
            <p class="framework-lead">
              Selecting your class defines how you interact with combat, exploration, and resource puzzles in 5e. Follow this 9-part strategic framework to match tabletop mechanics with your ideal character fantasy.
            </p>
          </div>

          <div class="framework-active-box">
            <div class="active-box-top">
              <span class="active-box-badge">Current Focus</span>
              <span id="framework-step-counter" class="active-step-counter">Step 01 / 09</span>
            </div>
            <h3 id="framework-scroll-label" class="framework-active-label" aria-live="polite">
              {initialFrameworkLabel}
            </h3>
            <p id="framework-hud-tip" class="framework-active-tip">
              {initialFrameworkTip}
            </p>
          </div>

          <nav class="framework-step-nav" aria-label="Framework step navigation">
            <span class="step-nav-label">Framework Steps</span>
            <div class="step-nav-list">
              {frameworkSections.map((sec, idx) => (
                <a
                  href={`#${sec.id}`}
                  class={`step-nav-item${idx === 0 ? ' is-active' : ''}`}
                  data-target-label={sec.label}
                  data-target-tip={sec.tip}
                  data-step-index={idx + 1}
                  aria-label={`Jump to step ${idx + 1}: ${sec.label}`}
                  aria-current={idx === 0 ? 'true' : undefined}
                >
                  <span class="step-pip">{idx + 1}</span>
                  <span class="step-name">{sec.label.replace(/^\d+\.\s*/, '')}</span>
                </a>
              ))}
            </div>
          </nav>

          <a href="#classes-roster" class="framework-roster-jump">
            <span>&uarr; Back to Class Roster</span>
          </a>
        </div>
      </aside>

      <div class="scroll-story-content">
        <section
          id="framework-pillars"
          class="content-card scroll-section in-view"
          aria-labelledby="framework-heading"
          data-section-label={frameworkSections[0].label}
          data-section-tip={frameworkSections[0].tip}
          data-step-index="1"
        >
          <span class="eyebrow">Step 01 &middot; Core Dimensions</span>
          <h3 class="framework-section-title">The Three Mechanical Selection Pillars</h3>
        <p>
          Selecting a character class is the single most defining mechanical and thematic choice you make in fifth edition tabletop roleplaying. While race and background supply cultural heritage and narrative origins, your class determines how you interact with every combat encounter, exploration challenge, and resource puzzle presented by your Dungeon Master. The ideal character aligns both your narrative fantasy and your preferred table gameplay loop.
        </p>
        <p>
          To discover the class that fits your playstyle, consider three core mechanical dimensions: resource management horizons, battlefield positioning preferences, and procedural rule complexity. Players who prefer low bookkeeping thrive on classes with at-will abilities or short rest recoveries, such as the Champion Fighter, the Rogue, or the Warlock. Players who relish managing intricate spell lists, anticipating dungeon hazards, and preparing situational countermeasures will naturally gravitate toward versatile prepared casters like the Wizard, Cleric, or Druid.
        </p>
        <p>
          Battlefield positioning represents another crucial division. Frontline warriors must possess high Armor Class and generous hit point reserves to endure focused enemy attacks in tight corridors. Skirmishers and ranged specialists need reliable mobility tools, such as the Rogue Cunning Action or the Monk Step of the Wind, allowing them to deliver lethal damage before retreating beyond enemy reach. Backline spellcasters trade physical durability for encounter-altering magic, staying safe behind armored allies while dictating battlefield geometry.
        </p>
        <p>
          Finally, evaluate team composition harmony. Fifth edition does not enforce a rigid holy trinity of tank, healer, and damage dealer, but a balanced party functions with greater confidence when all core ability check pillars are represented. Ensuring your adventuring group includes reliable Strength for athletic obstacles, Dexterity for stealth and trap disarming, Intelligence for arcana and investigation, Wisdom for perception and insight, and Charisma for social navigation prevents frustrating dead ends during campaign arcs.
        </p>
      </section>

      <section
        id="framework-roles"
        class="content-card scroll-section"
        aria-labelledby="roles-heading"
        data-section-label={frameworkSections[1].label}
        data-section-tip={frameworkSections[1].tip}
        data-step-index="2"
      >
        <span class="eyebrow">Step 02 &middot; Battlefield Dynamics</span>
        <h2 id="roles-heading">The Four Fundamental Party Roles in Tabletop Combat</h2>
        <p>
          Every class in 5e contributes to the party through a distinct combination of four tactical combat roles: Frontline Tanks, Precision Strikers, Battlefield Controllers, and Support Specialists. Recognizing where your chosen class sits across these spectrums helps you coordinate effectively with your companions during life-or-death encounters.
        </p>
        <div class="role-cards-grid">
          <div class="role-card">
            <h3>Frontline Tanks and Anchors</h3>
            <p>
              Frontline tanks hold chokepoints, absorb brutal physical punishment, and punish enemies who attempt to bypass them toward vulnerable spellcasters. Barbarians excel here by combining the game highest hit point pools with damage halving through Rage. Fighters bring ironclad Armor Class via plate armor and shields, supplemented by self-healing through Second Wind. Paladins anchor the frontline with heavy armor, burst healing from Lay on Hands, and defensive auras that safeguard adjacent companions.
            </p>
          </div>
          <div class="role-card">
            <h3>Precision Strikers and Skirmishers</h3>
            <p>
              Strikers specialize in single-target elimination, pinpointing high-value enemy targets and obliterating them before they unleash devastating attacks. Rogues embody precision through Sneak Attack, exploiting distraction to roll massive fistfuls of damage dice each turn. Monks leverage superior speed and Flurry of Blows to dive past enemy vanguards and lock down enemy spellcasters with Stunning Strike. Rangers and Blood Hunters deliver relentless weapon damage through hunter marks, archery styles, and elemental rites.
            </p>
          </div>
          <div class="role-card">
            <h3>Battlefield Controllers and Area Deniers</h3>
            <p>
              Controllers reshape the terrain of battle, turning chaotic skirmishes into manageable engagements through area-of-effect spells and crowd control conditions. Wizards stand as the ultimate controllers, deploying spells like Web, Hypnotic Pattern, and Wall of Force to divide enemy ranks. Druids command nature to conjure entangling vines, spike growth, and obscuring fogs that turn terrain lethal. Sorcerers sculpt magical fields using Metamagic, bending spells around companions to incapacitate clustered foes.
            </p>
          </div>
          <div class="role-card">
            <h3>Support Specialists and Force Multipliers</h3>
            <p>
              Support characters turn an ordinary adventuring party into an indomitable fighting unit. Clerics blend emergency restorative magic with game-altering buffs like Bless and spiritual area control through Spirit Guardians. Bards serve as supreme force multipliers, handing out Bardic Inspiration dice to turn failed attack rolls into critical hits while disrupting adversary saving throws with Cutting Words. Artificers bolster companions with bespoke magical infusions, defensive barriers, and versatile Flash of Genius boosts.
            </p>
          </div>
        </div>
      </section>

      <section
        id="framework-hitdice"
        class="content-card scroll-section"
        aria-labelledby="hitdie-heading"
        data-section-label={frameworkSections[2].label}
        data-section-tip={frameworkSections[2].tip}
        data-step-index="3"
      >
        <span class="eyebrow">Step 03 &middot; Physical Resilience</span>
        <h2 id="hitdie-heading">Complete Hit Die Hierarchy and Durability Analysis</h2>
        <p>
          Hit Dice govern your character baseline physical resilience, maximum health progression, and recuperation capacity during short rests. In fifth edition, classes are categorized into four distinct Hit Die tiers ranging from the monstrous d12 down to the fragile d6. Understanding these tiers helps you gauge how aggressively your character can position on the battlefield.
        </p>
        <div class="table-responsive">
          <table class="class-comparison-table">
            <thead>
              <tr>
                <th scope="col">Class</th>
                <th scope="col">Hit Die</th>
