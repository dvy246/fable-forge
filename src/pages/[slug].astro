---
import SiteLayout from '../layouts/SiteLayout.astro';
import Generator from '../components/Generator.astro';
import ToolCards from '../components/ToolCards.astro';
import { raceProfiles, raceBySlug } from '../data/races';
import { utilityPages, utilityBySlug } from '../data/utilities';
import { blogPosts } from '../data/blog-posts';
import { asGeneratorProfile, makeSampleResults } from '../lib/name-engine';
import { webApplicationSchema, faqPageSchema } from '../lib/seo';

const phaseTwoEnabled = import.meta.env.PUBLIC_BUILD_PHASE_2 !== 'false';

export function getStaticPaths() {
  const includePhaseTwo = import.meta.env.PUBLIC_BUILD_PHASE_2 !== 'false';
  const pages = includePhaseTwo ? [...raceProfiles, ...utilityPages] : raceProfiles;
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { slug: page.slug },
  }));
}

const { slug } = Astro.props;
const race = raceBySlug.get(slug);
const utility = utilityBySlug.get(slug);
const page = race ?? utility;

if (!page) throw new Error(`Missing generator data for ${slug}`);

const path = `/${page.slug}/`;
const heading = page.keyword
  .split(' ')
  .map((word) => word.toLowerCase() === 'dnd' ? 'DnD' : word.toLowerCase() === 'npc' ? 'NPC' : word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
const imageType = race ? 'race' : 'utility';
const faqSchema = page.faq ? faqPageSchema(page.faq) : null;
const schema = [
  webApplicationSchema(heading, page.description, path),
  ...(faqSchema ? [faqSchema] : []),
];
const breadcrumbs = [
  { label: 'Home', path: '/' },
  { label: race ? `${race.label} names` : utility?.label ?? 'Generator', path },
];
const relatedItems = race
  ? [
      ...race.relatedRaces.map((relatedSlug) => {
        const item = raceBySlug.get(relatedSlug);
        return item ? {
          slug: item.slug,
          title: `${item.label} names`,
          description: item.intro[0],
          eyebrow: 'Ancestry names',
        } : null;
      }).filter((item) => item !== null),
      ...(phaseTwoEnabled ? race.relatedUtilities : []).map((relatedSlug) => {
        const item = utilityBySlug.get(relatedSlug);
        return item ? {
          slug: item.slug,
          title: item.label,
          description: item.intro[0],
          eyebrow: 'Campaign utility',
        } : null;
      }).filter((item) => item !== null),
    ]
  : (utility?.related ?? []).map((relatedSlug) => {
      const raceItem = raceBySlug.get(relatedSlug);
      if (raceItem) return { slug: raceItem.slug, title: `${raceItem.label} names`, description: raceItem.intro[0], eyebrow: 'Ancestry names' };
      const utilityItem = utilityBySlug.get(relatedSlug);
      if (utilityItem) return { slug: utilityItem.slug, title: utilityItem.label, description: utilityItem.intro[0], eyebrow: 'Campaign utility' };
      return null;
    }).filter((item) => item !== null);
const sampleNames = race
  ? makeSampleResults(asGeneratorProfile(race), {
      race: race.slug,
      style: race.styles[0].id,
      placeStyle: 'harbor',
      gender: 'neutral',
      length: 'medium',
      fullName: false,
    }, 12)
  : [];
const faq = page.faq;
const storySections = race
  ? [
      { id: 'styles-heading', label: 'Naming Styles' },
      { id: 'how-heading', label: 'How Names Work' },
      { id: 'sample-heading', label: 'Sample Names' },
      { id: 'pronunciation-heading', label: 'Pronunciation Notes' },
      { id: 'table-heading', label: 'Table Tips' },
      { id: 'faq-heading', label: 'FAQ' },
    ]
  : [
      { id: 'intro-heading', label: 'Tool Guide' },
      ...(utility?.sections ?? []).map((section, index) => ({
        id: `utility-section-${index}`,
        label: section.heading,
      })),
      { id: 'faq-heading', label: 'FAQ' },
    ];
const initialSectionLabel = race ? 'Naming Style Options' : 'Tool Guide';

const directGuideMatches = blogPosts.filter((post) =>
  post.relatedTools?.includes(page.slug) ||
  post.relatedRaces?.includes(page.slug) ||
  (['kingdom-name-generator', 'world-name-generator'].includes(page.slug) && post.category === 'Worldbuilding')
);
const generalGuide = blogPosts.find((post) => post.slug === 'how-to-name-your-dnd-character');
const secondaryGuide = blogPosts.find((post) => post.slug === 'fantasy-town-naming-guide');

const matchedGuides = [...directGuideMatches];
if (generalGuide && !matchedGuides.some((g) => g.slug === generalGuide.slug)) {
  matchedGuides.push(generalGuide);
}
if (secondaryGuide && !matchedGuides.some((g) => g.slug === secondaryGuide.slug)) {
  matchedGuides.push(secondaryGuide);
}
const relatedGuides = matchedGuides.slice(0, 2);
---
<SiteLayout
  title={page.title}
  description={page.description}
  path={path}
  pageType="article"
  imageType={imageType}
  breadcrumbs={breadcrumbs}
  schema={schema}
  showTools={true}
>
  <section class="hero">
    <span class="eyebrow">{race ? `${race.label} name craft` : 'A campaign-ready utility'}</span>
    <h1>{heading}</h1>
    <p class="hero-copy">{page.intro[0]}</p>
  </section>

  <Generator
    toolType={race ? 'race' : utility!.toolType}
    profiles={race ? [race] : raceProfiles}
    defaultRace={race?.slug}
    heading={race ? 'The generator' : `Generate ${utility!.label.toLocaleLowerCase()}`}
    description={race ? 'Choose a naming style, shape the length, and keep a result that fits your character.' : 'Set a direction, roll ten original results, and keep the ones that fit your table.'}
  />

  <article class="page-section seo-copy" data-seo-copy>
    <div class="scroll-story">
      <aside class="scroll-story-sticky">
        <div class="scroll-story-visual">
          <div class="visual-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
              <path d="M6 2v20" />
              <path d="M10 7h6" />
              <path d="M10 11h6" />
              <path d="M10 15h4" />
            </svg>
          </div>
          <span class="scroll-story-badge">Guide</span>
          <h3 id="scroll-section-label" class="scroll-section-label" aria-live="polite" aria-atomic="true">{initialSectionLabel}</h3>
          <nav class="scroll-story-nav" aria-label="Section navigation">
            <div class="scroll-story-dots">
              {storySections.map((sec, idx) => (
                <a
                  href={`#${sec.id}`}
                  class={`scroll-dot${idx === 0 ? ' active' : ''}`}
                  data-target-label={sec.label}
                  data-tooltip={sec.label}
                  aria-label={`Jump to ${sec.label}`}
                  aria-current={idx === 0 ? 'true' : undefined}
                >
                  <span class="scroll-dot-pip"></span>
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>
      <div class="scroll-story-content">
        {race ? (
          <>
            <section class="content-card scroll-section in-view" aria-labelledby="styles-heading" data-section-label="Naming Styles">
              <span class="eyebrow">Three original sound palettes</span>
              <h2 id="styles-heading">Naming style options</h2>
              <p>{race.intro[1]}</p>
              {race.styles.map((style) => (
                <section class="style-block">
                  <h3>{style.label}</h3>
                  <p>{style.summary}</p>
                  <ul class="style-examples" aria-label={`${style.label} example names`}>
                    {style.examples.map((name) => <li>{name}</li>)}
                  </ul>
                </section>
              ))}
            </section>

            <section class="page-section content-card scroll-section" aria-labelledby="how-heading" data-section-label="How Names Work">
              <span class="eyebrow">A guide to the sound</span>
              <h2 id="how-heading">How {race.label} names work</h2>
              {race.construction.map((paragraph) => <p>{paragraph}</p>)}
            </section>

            <section class="page-section content-card scroll-section" aria-labelledby="sample-heading" data-section-label="Sample Names">
              <span class="eyebrow">Pre-rendered examples</span>
              <h2 id="sample-heading">Sample {race.label} names</h2>
              <p>These twelve names are included in the page before JavaScript runs. Use them as written or treat them as sound prompts for a new name.</p>
              <div class="sample-grid">
                {sampleNames.map((sample, index) => (
                  <article class="sample-card">
                    <span class="microcopy">Example {String(index + 1).padStart(2, '0')}</span>
                    <strong class="result-name sample-name">{sample.name}</strong>
                    <p class="result-flavor">{sample.flavor}</p>
                  </article>
                ))}
              </div>
            </section>

            <section class="page-section content-card scroll-section" aria-labelledby="pronunciation-heading" data-section-label="Pronunciation Notes">
              <span class="eyebrow">Say each name aloud</span>
              <h2 id="pronunciation-heading">Pronunciation notes</h2>
              <p>Use these guides as a first reading, then choose the pronunciation that feels natural in your setting.</p>
              <ul class="pronunciation-list">
                {race.pronunciation.map((item) => <li><strong>{item.name}</strong>, {item.guide}. {item.note}</li>)}
              </ul>
            </section>

            <section class="page-section content-card scroll-section" aria-labelledby="table-heading" data-section-label="Table Tips">
              <span class="eyebrow">Bring it to the table</span>
              <h2 id="table-heading">Using {race.label.toLocaleLowerCase()} names in play</h2>
              {race.tableTips.map((paragraph) => <p>{paragraph}</p>)}
            </section>

            <section class="page-section scroll-section" aria-labelledby="faq-heading" data-section-label="FAQ">
              <div class="section-topline">
                <div>
                  <span class="eyebrow">A few quick answers</span>
                  <h2 id="faq-heading" class="section-heading">Frequently asked questions</h2>
                </div>
              </div>
              <div class="faq-grid">
                {faq.map((item) => <article class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></article>)}
              </div>
            </section>
          </>
        ) : (
          <>
            <section class="content-card scroll-section in-view" aria-labelledby="intro-heading" data-section-label="Tool Guide">
              <span class="eyebrow">Make it useful at your table</span>
              <h2 id="intro-heading">How to use the {utility!.label.toLocaleLowerCase()} tool</h2>
              {utility!.intro.slice(1).map((paragraph) => <p>{paragraph}</p>)}
            </section>
            {utility!.sections.map((section, index) => (
              <section class="page-section content-card scroll-section" aria-labelledby={`utility-section-${index}`} data-section-label={section.heading}>
                <span class="eyebrow">A practical prompt</span>
                <h2 id={`utility-section-${index}`}>{section.heading}</h2>
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ))}
            <section class="page-section scroll-section" aria-labelledby="faq-heading" data-section-label="FAQ">
              <div class="section-topline">
                <div>
                  <span class="eyebrow">A few quick answers</span>
                  <h2 id="faq-heading" class="section-heading">Frequently asked questions</h2>
                </div>
              </div>
              <div class="faq-grid">
                {faq.map((item) => <article class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></article>)}
              </div>
            </section>
          </>
        )}
      </div>
    </div>
  </article>

  {relatedGuides.length > 0 && (
    <section class="page-section related-guides" aria-labelledby="guides-heading">
      <div class="section-topline">
        <div>
          <span class="eyebrow">Tabletop naming craft</span>
          <h2 id="guides-heading" class="section-heading">Naming guides for your campaign</h2>
        </div>
      </div>
      <div class="guide-grid">
        {relatedGuides.map((guide) => (
          <a href={`/blog/${guide.slug}/`} class="guide-card">
            <span class="guide-category">{guide.category}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="page-section" aria-labelledby="related-heading">
    <div class="section-topline">
      <div>
        <span class="eyebrow">Keep exploring</span>
        <h2 id="related-heading" class="section-heading">Related generators</h2>
      </div>
    </div>
    <ToolCards items={relatedItems} />
  </section>
</SiteLayout>

<script>
  (() => {
    const story = document.querySelector('.scroll-story');
    if (!story) return;

    const labelEl = document.getElementById('scroll-section-label');
    const visualEl = story.querySelector('.scroll-story-visual');
    const sections = Array.from(story.querySelectorAll('.scroll-section'));
    const dots = Array.from(story.querySelectorAll('.scroll-dot'));
    if (!sections.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeSection = null;
    let pulseTimer = null;
    let isClickScrolling = false;
    let scrollTimeout = null;

    function activateSection(target) {
      if (!target || target === activeSection) return;
      activeSection = target;

      sections.forEach((sec) => {
        if (sec === target) {
          sec.classList.add('in-view');
        } else {
          sec.classList.remove('in-view');
        }
      });

      const label = target.dataset.sectionLabel;
      if (label && labelEl) {
        labelEl.textContent = label;
      }

      dots.forEach((dot) => {
        if (dot.dataset.targetLabel === label) {
          dot.classList.add('active');
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.classList.remove('active');
          dot.removeAttribute('aria-current');
        }
      });

      if (visualEl && !prefersReducedMotion) {
        visualEl.classList.remove('pulse');
        void visualEl.offsetWidth;
        visualEl.classList.add('pulse');
        clearTimeout(pulseTimer);
        pulseTimer = setTimeout(() => {
          visualEl.classList.remove('pulse');
        }, 600);
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetLabel = dot.dataset.targetLabel;
        const targetSec = sections.find((s) => s.dataset.sectionLabel === targetLabel);
        if (targetSec) {
          isClickScrolling = true;
          activateSection(targetSec);
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            isClickScrolling = false;
          }, 800);
        }
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (isClickScrolling) return;
          const intersecting = entries.filter((e) => e.isIntersecting);
          if (intersecting.length > 0) {
            intersecting.sort((a, b) => Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top));
            activateSection(intersecting[0].target);
          }
        },
        {
          rootMargin: '-20% 0px -55% 0px',
          threshold: 0,
        }
      );

      sections.forEach((sec) => observer.observe(sec));
    }
  })();
</script>
