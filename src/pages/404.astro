---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
  title="Page Not Found: DnD Arena"
  description="Page not found. Return to the DnD Arena fantasy name generator to make original ancestry, character, town, and tavern names for your next game session."
  path="/404/"
  noindex={true}
>
  <section class="simple-page">
    <span class="eyebrow">The trail ends here</span>
    <h1>That page is not on this map</h1>
    <p>The address may have changed, or the page may never have existed. Head back to the generator hub to choose another path.</p>
    <p><a class="text-link" href="/">Return to the DnD name generator</a></p>
  </section>
</SiteLayout>
